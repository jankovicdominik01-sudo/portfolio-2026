# ── Voliteľné (bez nich: kľúč z BLOB tokenu, predvolené účty v lib/auth.ts) ──
# Podpis session cookie (min. 32 znakov, náhodný reťazec)
SESSION_SECRET=
# Používatelia: meno|Zobrazované meno|rola(admin/caller)|heslo alebo scrypt$salt$hash; oddelené „;“
LE_USERS=dominik|Dominik Jankovič|admin|silne-heslo;jozo|Jozo|caller|ine-heslo

# ── Úložisko (vyber jedno) ─────────────────────────────────────────
# Produkcia: Supabase (schéma v supabase/migrations/0001_lead_engine.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Test / demo: Vercel Blob (nastaví sa automaticky po pripojení Blob store)
BLOB_READ_WRITE_TOKEN=
# Bez oboch → lokálny súbor .data/db.json (iba vývoj)

# ── AI analýza (voliteľné — bez kľúča beží pravidlový analyzátor) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── Automatizácia (ranná rutina, ingestion API) ────────────────────
# Bearer kľúč pre /api/v1/* (min. 24 znakov)
LE_API_KEY=
